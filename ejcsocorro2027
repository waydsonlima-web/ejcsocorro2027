<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EJC Socorro 2027 - Menu</title>

    <!-- Fontes e Ícones -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background:
                linear-gradient(rgba(0, 0, 0, 0.52), rgba(0, 0, 0, 0.52)),
                url('https://raw.githubusercontent.com/waydsonlima-web/fotos_ejcsocorro2027/main/m%C3%A3e-do-perp%C3%A9tuo-socorro.jpg')
                no-repeat center center fixed;
            background-size: cover;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 15px;
        }

        .mobile-container {
            width: 100%;
            max-width: 500px;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            padding: 28px 25px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.30);
            text-align: center;
        }

        .logo-icon {
            width: 58px;
            height: 58px;
            margin: 0 auto 12px;
            border-radius: 50%;
            background: #d4af37;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 26px;
            box-shadow: 0 5px 15px rgba(212, 175, 55, 0.35);
        }

        h1 {
            color: #2c3e50;
            font-weight: 600;
            font-size: 25px;
            line-height: 1.25;
            margin-bottom: 7px;
        }

        .subtitle {
            color: #64748b;
            font-size: 14px;
            line-height: 1.5;
            margin-bottom: 22px;
        }

        .divider {
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 10px 0 15px;
        }

        .divider::before,
        .divider::after {
            content: "";
            height: 2px;
            flex: 1;
            background: #d4af37;
        }

        .divider i {
            color: #d4af37;
            font-size: 18px;
        }

        .menu {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .menu-card {
            display: flex;
            align-items: center;
            text-align: left;
            text-decoration: none;
            color: inherit;
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 14px;
            padding: 16px;
            box-shadow: 0 5px 15px rgba(15, 23, 42, 0.08);
            transition: all 0.25s ease;
            cursor: pointer;
        }

        .menu-card:hover {
            transform: translateY(-3px);
            border-color: #d4af37;
            box-shadow: 0 9px 20px rgba(15, 23, 42, 0.14);
        }

        .menu-icon {
            width: 52px;
            height: 52px;
            flex-shrink: 0;
            border-radius: 12px;
            background: #eef6f1;
            color: #27ae60;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            margin-right: 14px;
        }

        .menu-card:nth-child(2) .menu-icon {
            background: #fff8df;
            color: #c99c19;
        }

        .menu-card:nth-child(3) .menu-icon {
            background: #edf4fb;
            color: #2c6eaa;
        }

        .menu-content {
            flex: 1;
            min-width: 0;
        }

        .menu-content h2 {
            color: #2c3e50;
            font-size: 17px;
            font-weight: 600;
            margin-bottom: 3px;
        }

        .menu-content p {
            color: #64748b;
            font-size: 12.5px;
            line-height: 1.35;
        }

        .arrow {
            color: #94a3b8;
            font-size: 18px;
            margin-left: 10px;
        }

        .footer {
            margin-top: 20px;
            color: #94a3b8;
            font-size: 11px;
        }

        @media (max-width: 420px) {
            .mobile-container {
                padding: 23px 17px;
            }

            h1 {
                font-size: 22px;
            }

            .menu-content h2 {
                font-size: 16px;
            }
        }
    </style>
</head>

<body>

    <div class="mobile-container">

        <div class="logo-icon">
            <i class="fa-solid fa-cross"></i>
        </div>

        <h1>EJC Socorro 2027</h1>

        <div class="divider">
            <i class="fa-solid fa-heart"></i>
        </div>

        <p class="subtitle">
            Acesse abaixo os formulários e páginas do nosso encontro.
        </p>

        <div class="menu">

            <!-- 1. CADASTRO DE FOTOS -->
            <a class="menu-card"
               href="https://waydsonlima-web.github.io/fotos_ejcsocorro2027/"
               target="_blank"
               rel="noopener noreferrer">

                <div class="menu-icon">
                    <i class="fa-solid fa-camera"></i>
                </div>

                <div class="menu-content">
                    <h2>Cadastro de Fotos</h2>
                    <p>Importação de Foto</p>
                </div>

                <div class="arrow">
                    <i class="fa-solid fa-chevron-right"></i>
                </div>
            </a>


            <!-- 2. RIFA -->
            <a class="menu-card"
               href="https://waydsonlima-web.github.io/rifaejcsocorro2027/"
               target="_blank"
               rel="noopener noreferrer">

                <div class="menu-icon">
                    <i class="fa-solid fa-ticket"></i>
                </div>

                <div class="menu-content">
                    <h2>Rifa em prol EJC Socorro</h2>
                    <p>Rifa EJC Nossa Senhora do Perpétuo Socorro</p>
                </div>

                <div class="arrow">
                    <i class="fa-solid fa-chevron-right"></i>
                </div>
            </a>


            <!-- 3. CADASTRO DE ENDEREÇO -->
            <a class="menu-card"
               href="https://waydsonlima-web.github.io/cadastrodeendereco/"
               target="_blank"
               rel="noopener noreferrer">

                <div class="menu-icon">
                    <i class="fa-solid fa-location-dot"></i>
                </div>

                <div class="menu-content">
                    <h2>Cadastro de Endereço</h2>
                    <p>Cadastro de Endereço dos Padrinhos</p>
                </div>

                <div class="arrow">
                    <i class="fa-solid fa-chevron-right"></i>
                </div>
            </a>

        </div>

        <div class="footer">
            Nossa Senhora do Perpétuo Socorro, rogai por nós.
        </div>

    </div>

</body>
</html>
